    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // --- Three.js Hero Background ---
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ canvas: document.getElementById('hero-canvas'), alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);

        const particlesGeometry = new THREE.BufferGeometry;
        const particlesCnt = 5000;
        const posArray = new Float32Array(particlesCnt * 3);

        for(let i = 0; i < particlesCnt * 3; i++) {
            posArray[i] = (Math.random() - 0.5) * 5;
        }

        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));

        const particlesMaterial = new THREE.PointsMaterial({
            size: 0.005,
            color: 0x64ffda
        });

        const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particlesMesh);
        camera.position.z = 2;

        let mouseX = 0;
        let mouseY = 0;
        document.addEventListener('mousemove', (event) => {
            mouseX = event.clientX;
            mouseY = event.clientY;
        });

        const clock = new THREE.Clock();
        const animate = () => {
            const elapsedTime = clock.getElapsedTime();
            particlesMesh.rotation.y = -0.1 * elapsedTime;
            if (mouseX > 0) {
                particlesMesh.rotation.x = -mouseY * (elapsedTime * 0.00008);
                particlesMesh.rotation.y = -mouseX * (elapsedTime * 0.00008);
            }
            renderer.render(scene, camera);
            window.requestAnimationFrame(animate);
        };
        animate();

        window.addEventListener('resize', () => {
            renderer.setSize(window.innerWidth, window.innerHeight);
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
        });


        // --- Simple scroll animations ---
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-fade-in-up');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('section > *:not(.hero-element)').forEach(el => {
            el.classList.add('opacity-0');
            observer.observe(el);
        });

        const style = document.createElement('style');
        style.innerHTML = `
            @keyframes fade-in-up {
                from { opacity: 0; transform: translateY(20px); }
                to { opacity: 1; transform: translateY(0); }
            }
            .animate-fade-in-up { animation: fade-in-up 0.8s ease-out forwards; }
        `;
        document.head.appendChild(style);

        // --- Gemini API Integration ---
        const apiKey = ""; // This will be handled by the environment

        // --- AI Chatbot Logic ---
        const chatBubble = document.getElementById('chat-bubble');
        const chatModal = document.getElementById('chat-modal');
        const closeChatBtn = document.getElementById('close-chat');
        const chatBody = document.getElementById('chat-body');
        const chatInput = document.getElementById('chat-input');
        const sendChatBtn = document.getElementById('send-chat-btn');
        const chatInputContainer = document.getElementById('chat-input-container');

        let chatHistory = [];
        let conversationState = 'greeting'; // greeting, asking_name, asking_company, asking_email, asking_timings, idle
        let recruiterInfo = { name: '', company: '', email: '', timings: ''};

        function startConversation() {
            chatBody.innerHTML = ''; // Clear chat
            addMessageToChat('ai', "Hello! I'm Siva's AI assistant. Before we begin, could I get your name?");
            conversationState = 'asking_name';
            chatInputContainer.style.display = 'flex';
            chatInput.focus();
        }

        // Function to get resume context
        const getResumeContext = () => {
            return `
                Resume of Siva Krishna L, Senior Python Developer.
                Summary: 5+ years experience in backend systems, APIs, cloud-native tech (GCP, AWS), containerization.
                Core Competencies: Backend Architecture, Cloud & DevOps, API Development, Data Engineering.
                Experience 1: Senior Python Developer at AAA - AutoClubGroup (June 2024 - Present). Migrating Java APIs to Python/FastAPI on GCP.
                Experience 2: Python Developer at Cognizant for Directline Group (Aug 2020 - Jul 2022). Enhanced policy management on AWS.
                Experience 3: Junior to Mid-Level Python Developer at Cognizant for Directline Group (Aug 2018 - Jul 2020). Developed internal tools, integrated with Guidewire.
                Case Study 1 (AAA): Solved legacy API bottlenecks by migrating to a Python/FastAPI microservices architecture on GCP. Impact: 40% faster API response, 150% more throughput, 60% faster deployment.
                Case Study 2 (Directline): Addressed manual data entry issues by building a Celery/Redis data sync service to connect Python apps with Guidewire. Impact: Saved 25+ hours/week, improved data consistency by 40%.
                Education: Master of Science in Information Systems from Central Michigan University (Graduated May 2024).
                Certifications: AWS Certified Developer – Associate (Issued July 2025).
                Skills: Python, Django, FastAPI, Pydantic, Pytest, PostgreSQL, Redis, GCP, AWS, Docker, Kubernetes, Terraform, Git, Bitbucket, GitHub, CI/CD.
                Contact: lingutlasiva@gmail.com, (989) 824-0655, linkedin.com/in/siva-lingutla
            `;
        };

        chatBubble.addEventListener('click', () => {
            chatModal.classList.toggle('hidden');
            if (!chatModal.classList.contains('hidden') && conversationState === 'greeting') {
                startConversation();
            }
        });
        closeChatBtn.addEventListener('click', () => chatModal.classList.add('hidden'));
        sendChatBtn.addEventListener('click', handleUserInput);
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') handleUserInput();
        });

        async function handleUserInput() {
            const userMessage = chatInput.value.trim();
            if (!userMessage) return;

            addMessageToChat('user', userMessage);
            chatInput.value = '';

            if (conversationState === 'asking_name') {
                recruiterInfo.name = userMessage;
                addMessageToChat('ai', `Great to meet you, ${recruiterInfo.name}! Which company are you with?`);
                conversationState = 'asking_company';
            } else if (conversationState === 'asking_company') {
                recruiterInfo.company = userMessage;
                addMessageToChat('ai', `And what's the best email to reach you at?`);
                conversationState = 'asking_email';
            } else if (conversationState === 'asking_email') {
                recruiterInfo.email = userMessage;
                addMessageToChat('ai', `Thanks. Lastly, what are your preferred timings for a call? (e.g., "Weekdays after 3 PM EST")`);
                conversationState = 'asking_timings';
            } else if (conversationState === 'asking_timings') {
                recruiterInfo.timings = userMessage;
                addMessageToChat('ai', `Thank you! To ensure Siva receives your details, please click the button below. It will open your email client with your contact information pre-filled, ready to send to him.`);
                sendNotificationEmail();
                conversationState = 'idle';
            }
            else {
                showTypingIndicator();
                const intent = determineIntentLocally(userMessage);

                if (intent === 'schedule_meeting') {
                    removeTypingIndicator();
                    addMessageToChat('ai', "Great! The best way to schedule a meeting is to email Siva directly. His email is: lingutlasiva@gmail.com");
                    addMessageToChat('ai', "Is there anything else I can help you with?");

                } else if (intent === 'share_contact') {
                    removeTypingIndicator();
                    addMessageToChat('ai', "Siva's contact information is:\nEmail: lingutlasiva@gmail.com\nPhone: (989) 824-0655\nLinkedIn: linkedin.com/in/siva-lingutla");
                }
                else {
                    const prompt = `You are an AI assistant for Siva Krishna L's resume. Your personality is professional and concise. Answer the user's question based *only* on the provided context. If the answer isn't in the context, say "I don't have that specific information, but you can reach out to Siva for more details."\n\nContext:\n${getResumeContext()}\n\nUser Question: ${userMessage}`;
                    try {
                        const aiResponse = await callGemini(prompt, chatHistory);
                        chatHistory.push({ role: "user", parts: [{ text: userMessage }] });
                        chatHistory.push({ role: "model", parts: [{ text: aiResponse }] });
                        removeTypingIndicator();
                        addMessageToChat('ai', aiResponse);
                    } catch (error) {
                        console.error("Chatbot error:", error);
                        removeTypingIndicator();
                        addMessageToChat('ai', "Sorry, I'm having trouble connecting. Please try again.");
                    }
                }
            }
        }

        function sendNotificationEmail() {
            const subject = encodeURIComponent(`Contact Details from ${recruiterInfo.name} at ${recruiterInfo.company}`);
            const body = encodeURIComponent(`Hi Siva,\n\nHere are my contact details:\n\nName: ${recruiterInfo.name}\nCompany: ${recruiterInfo.company}\nEmail: ${recruiterInfo.email}\nPreferred Timings: ${recruiterInfo.timings}\n\n(This email was generated by your interactive resume assistant.)`);
            const mailtoLink = `mailto:lingutlasiva@gmail.com?subject=${subject}&body=${body}`;

            const notificationDiv = document.createElement('div');
            notificationDiv.innerHTML = `<a href="${mailtoLink}" target="_blank" class="inline-block mt-2 bg-teal-400 text-slate-900 font-bold px-4 py-2 rounded-md hover:bg-teal-300 transition-colors">Send My Details to Siva</a>`;
            chatBody.appendChild(notificationDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
            
            setTimeout(() => {
                addMessageToChat('ai', "Now, what can I help you with? Feel free to ask about Siva's skills, experience, or projects.");
            }, 1000);
        }

        function determineIntentLocally(message) {
            const lowerCaseMessage = message.toLowerCase();
            const scheduleKeywords = ['schedule', 'meeting', 'appointment', 'talk', 'call', 'interview'];
            const contactKeywords = ['contact', 'email', 'phone', 'linkedin'];

            if (scheduleKeywords.some(keyword => lowerCaseMessage.includes(keyword))) {
                return 'schedule_meeting';
            }
            if (contactKeywords.some(keyword => lowerCaseMessage.includes(keyword))) {
                return 'share_contact';
            }
            return 'general_question';
        }

        function addMessageToChat(sender, message) {
            const messageDiv = document.createElement('div');
            messageDiv.classList.add('chat-message', 'p-3', 'rounded-lg', 'text-sm', 'leading-relaxed', sender === 'user' ? 'user-message' : 'ai-message');
            messageDiv.innerText = message;
            chatBody.appendChild(messageDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }
        
        function showTypingIndicator() {
            const typingDiv = document.createElement('div');
            typingDiv.id = 'typing-indicator';
            typingDiv.classList.add('chat-message', 'ai-message', 'p-3', 'rounded-lg');
            typingDiv.innerHTML = '<div class="loader"></div>';
            chatBody.appendChild(typingDiv);
            chatBody.scrollTop = chatBody.scrollHeight;
        }

        function removeTypingIndicator() {
            const indicator = document.getElementById('typing-indicator');
            if (indicator) indicator.remove();
        }


        // --- Generic Gemini API Caller ---
        async function callGemini(prompt, history = []) {
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`;
            
            let contents = [...history];
            contents.push({ role: "user", parts: [{ text: prompt }] });

            const payload = { contents };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error(`API call failed with status: ${response.status}`);
            }

            const result = await response.json();
            
            if (result.candidates && result.candidates.length > 0 && result.candidates[0].content && result.candidates[0].content.parts.length > 0) {
                return result.candidates[0].content.parts[0].text;
            } else {
                 console.warn("Gemini API response was empty or malformed.", result);
                 if (result.candidates && result.candidates[0]?.finishReason === 'SAFETY') {
                     return "The response was blocked due to safety settings. Please rephrase your request.";
                 }
                return "I couldn't generate a response. Please try again.";
            }
        }
    });
    </script>
</body>
